{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sandbox-gw",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  // Shared gateway token lives in the secret store, never in this file:
  //   npx wrangler secret put GATEWAY_TOKEN        (deployed)
  //   GATEWAY_TOKEN=... in .dev.vars              (local dev)
  // The Worker reads it as env.GATEWAY_TOKEN.
  "containers": [
    {
      "class_name": "Sandbox",
      "image": "./Dockerfile",
      "instance_type": "lite",
      "max_instances": 20
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "Sandbox",
        "name": "Sandbox"
      },
      {
        "class_name": "ContainerProxy",
        "name": "ContainerProxy"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Sandbox", "ContainerProxy"]
    }
  ]
}
